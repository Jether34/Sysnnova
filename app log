async function checkDB() {
  const db = await new Promise((r,j)=>{const o=indexedDB.open("sysnnova-offline");o.onsuccess=()=>r(o.result);o.onerror=()=>r(null);});
  if(!db)return console.log("No DB");
  const tx=db.transaction(["cache","outbox","meta"],"readonly");
  const [cache,outbox,meta]=await Promise.all([
