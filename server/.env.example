# Server
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/agrimind
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# SMTP (Nodemailer) - configure with your mail provider
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<gmail address>, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sysnnova <no-reply@sysnnova.local>"
